bool ok = true;
u8 a = 0;
u8 b = 0;
u8 expected = 0;

function check_add()
{
    u8 got = a + b;
    if(got != expected) { ok = false; }
}
function check_sub()
{
    u8 got = a - b;
    if(got != expected) { ok = false; }
}
function check_mul()
{
    u8 got = a * b;
    if(got != expected) { ok = false; }
}
function check_div()
{
    u8 got = a / b;
    if(got != expected) { ok = false; }
}
function check_mod()
{
    u8 got = a % b;
    if(got != expected) { ok = false; }
}
function check_and()
{
    u8 got = a & b;
    if(got != expected) { ok = false; }
}
function check_or()
{
    u8 got = a | b;
    if(got != expected) { ok = false; }
}
function check_xor()
{
    u8 got = a ^ b;
    if(got != expected) { ok = false; }
}
function check_shl()
{
    u8 got = a << b;
    if(got != expected) { ok = false; }
}
function check_shr()
{
    u8 got = a >> b;
    if(got != expected) { ok = false; }
}

