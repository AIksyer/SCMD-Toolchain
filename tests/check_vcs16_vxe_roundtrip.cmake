if(NOT DEFINED AS OR NOT DEFINED RUN OR NOT DEFINED DUMP OR NOT DEFINED SOURCE OR NOT DEFINED OUTDIR)
    message(FATAL_ERROR "AS, RUN, DUMP, SOURCE and OUTDIR are required")
endif()
file(REMOVE_RECURSE "${OUTDIR}")
file(MAKE_DIRECTORY "${OUTDIR}")
set(VXE "${OUTDIR}/program.vxe")
execute_process(COMMAND "${AS}" "${SOURCE}" -o "${VXE}" RESULT_VARIABLE arc OUTPUT_VARIABLE aout ERROR_VARIABLE aerr)
if(NOT arc EQUAL 0)
    message(FATAL_ERROR "vcs16as failed (${arc})\n${aout}\n${aerr}")
endif()
execute_process(COMMAND "${RUN}" "${VXE}" RESULT_VARIABLE rrc OUTPUT_VARIABLE rout ERROR_VARIABLE rerr)
if(NOT rrc EQUAL 0 OR NOT rout MATCHES "55")
    message(FATAL_ERROR "VXE run failed (${rrc})\n${rout}\n${rerr}")
endif()
execute_process(COMMAND "${DUMP}" "${VXE}" RESULT_VARIABLE drc OUTPUT_VARIABLE dout ERROR_VARIABLE derr)
if(NOT drc EQUAL 0 OR NOT dout MATCHES "vCS-16/2 VXE2" OR NOT dout MATCHES "instructions=10")
    message(FATAL_ERROR "VXE dump failed (${drc})\n${dout}\n${derr}")
endif()
