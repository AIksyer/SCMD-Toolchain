{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 22,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "clang-base",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "BUILD_TESTING": "ON",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "clang-debug",
      "inherits": "clang-base",
      "binaryDir": "${sourceDir}/out/build/clang-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SCMD_DIST_FLAVOR": "debug"
      }
    },
    {
      "name": "clang-release",
      "inherits": "clang-base",
      "binaryDir": "${sourceDir}/out/build/clang-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SCMD_DIST_FLAVOR": "release"
      }
    },
    {
      "name": "clang-sanitize",
      "inherits": "clang-base",
      "binaryDir": "${sourceDir}/out/build/clang-sanitize",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SCMD_ENABLE_SANITIZERS": "ON",
        "SCMD_DIST_FLAVOR": "sanitize"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "clang-debug",
      "configurePreset": "clang-debug"
    },
    {
      "name": "clang-release",
      "configurePreset": "clang-release"
    },
    {
      "name": "clang-sanitize",
      "configurePreset": "clang-sanitize"
    }
  ],
  "testPresets": [
    {
      "name": "clang-debug",
      "configurePreset": "clang-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "clang-release",
      "configurePreset": "clang-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "clang-sanitize",
      "configurePreset": "clang-sanitize",
      "output": {
        "outputOnFailure": true
      },
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=1:halt_on_error=1",
        "UBSAN_OPTIONS": "halt_on_error=1"
      }
    }
  ]
}
